[Unit]
Description=Tanyora quarantine and antivirus service
After=network-online.target docker.service clamav-daemon.service
Requires=docker.service
[Service]
Type=simple
WorkingDirectory=/opt/tanyora-safety
EnvironmentFile=/opt/tanyora-safety/service.env
ExecStart=/usr/bin/python3 /opt/tanyora-safety/service.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=350M
[Install]
WantedBy=multi-user.target
