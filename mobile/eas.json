{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_DISTRIBUTION": "direct" },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": { "EXPO_PUBLIC_DISTRIBUTION": "play" },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}